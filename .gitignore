data/
raw/
work/
processed/
*.fasta
*.fa
*.fastq
*.fq
*.gz
*.zip
*.bam
*.sam
*.vcf
# Si algún día necesitas versionar un archivo pequeño de data/,
# puedes forzarlo con una excepción, por ejemplo:  !data/ejemplo_mini.csv

# Base de datos de AMRFinderPlus (descargable con amrfinder_update -d, ver
# ensure_amrfinderplus_db() en 02_estimacion_recursos.ipynb) -- a diferencia de
# localDB/card.json (ya versionado, 42MB), esta base es mucho más pesada y no
# tiene sentido cargarla al repo pudiendo regenerarse con un comando.
localDB/
card.json
card_data.tar.bz2

# ============================================================
#  Credenciales y secretos  ->  jamás en el repositorio
# ============================================================
.env
*.key
*.pem
credentials*
secrets*

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# ============================================================
#  Jupyter
# ============================================================
.ipynb_checkpoints/

# ============================================================
#  Entornos virtuales / conda
#  (el entorno vive fuera del repo; solo versionamos environment.yml)
# ============================================================
.venv/
venv/
env/
envs/

